+class PhoneNotice(BaseModel):
+    app: str = ""
+    title: str = ""
+    text: str = ""
+
+
+_URL_RE = re.compile(r"https?://\S+")
+
+
+def notice_sentence(n: PhoneNotice) -> str:
+    """'WhatsApp. Anna. Are we still on for tonight?' - one speakable line, links shortened, length capped."""
+    parts = []
+    for raw in (n.app, n.title, n.text):
+        part = " ".join(_URL_RE.sub("a link", raw or "").split())
+        if part:
+            parts.append(part if part[-1] in ".!?" else part + ".")
+    return " ".join(parts)[:NOTIFY_MAX_CHARS]
+
+
+@app.post("/notify")
+async def notify(notice: PhoneNotice):
+    """A phone notification: queue it for the next announce so the bar reads it out."""
+    sentence = notice_sentence(notice)
+    if not sentence or _announcements.qsize() >= NOTIFY_MAX_QUEUE:
+        return Response(status_code=204)
+    print(f"Phone notification: {sentence!r}")
+    log_line("Phone", sentence)
+    _announcements.put((sentence, False))     # no chime: that is for timers and alarms
+    return Response(status_code=204)
+
